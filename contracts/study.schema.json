        },
        "cpu_ns": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cpu Ns"
        },
        "wall_ns": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
