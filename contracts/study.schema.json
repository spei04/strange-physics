            },
            {
              "type": "null"
            }
          ],
          "title": "Wall Ns"
        },
        "artifact_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Artifact Bytes"
        },
        "facts": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeWorkFacts"
            },
            {
              "type": "null"
