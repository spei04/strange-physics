{
  "$defs": {
    "NativeAccountingPlan": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "strange-physics.native-accounting-plan.v1",
          "default": "strange-physics.native-accounting-plan.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "study_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Study Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "synthetic_validation",
            "native_comparison"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "approval_id": {
          "const": "NATIVE_COMPARISON_APPROVAL_2026_10_21",
          "title": "Approval Id",
          "type": "string"
        },
        "episode_limit": {
          "default": 36,
          "maximum": 36,
          "minimum": 36,
          "title": "Episode Limit",
          "type": "integer"
        },
        "purchase_limit": {
          "default": 432,
          "maximum": 432,
          "minimum": 432,
          "title": "Purchase Limit",
          "type": "integer"
        },
        "cpu_limit_ns": {
          "default": 28800000000000,
          "maximum": 28800000000000,
          "minimum": 28800000000000,
          "title": "Cpu Limit Ns",
          "type": "integer"
        },
        "artifact_limit_bytes": {
          "default": 1073741824,
          "maximum": 1073741824,
          "minimum": 1073741824,
          "title": "Artifact Limit Bytes",
          "type": "integer"
        },
        "cost_policy": {
          "const": "all-work-no-reset.v1",
          "default": "all-work-no-reset.v1",
          "title": "Cost Policy",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "purpose",
        "approval_id"
      ],
      "title": "NativeAccountingPlan",
      "type": "object"
    },
    "NativeBudgetView": {
      "additionalProperties": false,
      "properties": {
        "purchased_slots": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Purchased Slots",
          "type": "integer"
        },
        "remaining_slots": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Remaining Slots",
          "type": "integer"
        },
        "charged_cpu_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Charged Cpu Ns",
          "type": "integer"
        },
        "remaining_cpu_ns": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Remaining Cpu Ns",
          "type": "integer"
        },
        "charged_artifact_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Charged Artifact Bytes",
          "type": "integer"
        },
        "remaining_artifact_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Remaining Artifact Bytes",
          "type": "integer"
        },
        "unresolved_attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Unresolved Attempts",
          "type": "integer"
        },
        "over_limit": {
          "title": "Over Limit",
          "type": "boolean"
        }
      },
      "required": [
        "purchased_slots",
        "remaining_slots",
        "charged_cpu_ns",
        "remaining_cpu_ns",
        "charged_artifact_bytes",
        "remaining_artifact_bytes",
        "unresolved_attempts",
        "over_limit"
      ],
      "title": "NativeBudgetView",
      "type": "object"
    },
    "NativeCellSummary": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Cell Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "unstarted",
            "in_progress",
            "complete",
            "failed",
            "incomplete",
            "cap_limited"
          ],
          "title": "Status",
          "type": "string"
        },
        "purchased_slots": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Purchased Slots",
          "type": "integer"
        },
        "unresolved_attempts": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Unresolved Attempts",
          "type": "integer"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/StudyCellOutcome"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "cell_id",
        "status",
        "purchased_slots",
        "unresolved_attempts",
        "outcome"
      ],
      "title": "NativeCellSummary",
      "type": "object"
    },
    "NativeStudyCell": {
      "additionalProperties": false,
      "properties": {
        "cell_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Cell Id",
          "type": "string"
        },
        "world_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "World Id",
          "type": "string"
        },
        "policy_seed": {
          "maximum": 4294967295,
          "minimum": 0,
          "title": "Policy Seed",
          "type": "integer"
        },
        "selector": {
          "enum": [
            "random",
            "uniform_disagreement",
            "posterior_disagreement"
          ],
          "title": "Selector",
          "type": "string"
        },
        "journal_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Journal Id",
          "type": "string"
        },
        "purchased_slots": {
          "default": 12,
          "maximum": 12,
          "minimum": 12,
          "title": "Purchased Slots",
          "type": "integer"
        },
        "calibration_slots": {
          "default": 4,
          "maximum": 4,
          "minimum": 4,
          "title": "Calibration Slots",
          "type": "integer"
        }
      },
      "required": [
        "cell_id",
        "world_id",
        "policy_seed",
        "selector",
        "journal_id"
      ],
      "title": "NativeStudyCell",
      "type": "object"
    },
    "NativeStudyLedger": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "strange-physics.native-study-ledger.v1",
          "default": "strange-physics.native-study-ledger.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/NativeAccountingPlan"
        },
        "records": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StudyLedgerRecord"
          },
          "maxItems": 8192,
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "plan"
      ],
      "title": "NativeStudyLedger",
      "type": "object"
    },
    "NativeStudyManifest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "strange-physics.native-study-manifest.v1",
          "default": "strange-physics.native-study-manifest.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "accounting_plan_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Accounting Plan Sha256",
          "type": "string"
        },
        "source_commit": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        },
        "uv_lock_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Uv Lock Sha256",
          "type": "string"
        },
        "engine_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "world_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "title": "World Ids",
          "type": "array"
        },
        "policy_seeds": {
          "items": {
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Policy Seeds",
          "type": "array"
        },
        "artifacts": {
          "items": {
            "$ref": "#/$defs/StudyArtifact"
          },
          "maxItems": 14,
          "minItems": 14,
          "title": "Artifacts",
          "type": "array"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/StudyGate"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Gates",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/NativeStudyCell"
          },
          "maxItems": 36,
          "minItems": 36,
          "title": "Cells",
          "type": "array"
        },
        "failure_policy": {
          "const": "retain-every-cell-and-attempt.v1",
          "default": "retain-every-cell-and-attempt.v1",
          "title": "Failure Policy",
          "type": "string"
        },
        "primary_output": {
          "const": "one-selected-native-candidate.v1",
          "default": "one-selected-native-candidate.v1",
          "title": "Primary Output",
          "type": "string"
        }
      },
      "required": [
        "accounting_plan_sha256",
        "source_commit",
        "uv_lock_sha256",
        "engine_fingerprint",
        "world_ids",
        "policy_seeds",
        "artifacts",
        "gates",
        "cells"
      ],
      "title": "NativeStudyManifest",
      "type": "object"
    },
    "NativeStudySummary": {
      "additionalProperties": false,
      "properties": {
        "study_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Study Id",
          "type": "string"
        },
        "accounting_plan_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Accounting Plan Sha256",
          "type": "string"
        },
        "ledger_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Ledger Sha256",
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Manifest Sha256"
        },
        "budget": {
          "$ref": "#/$defs/NativeBudgetView"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/NativeCellSummary"
          },
          "maxItems": 36,
          "title": "Cells",
          "type": "array"
        }
      },
      "required": [
        "study_id",
        "accounting_plan_sha256",
        "ledger_sha256",
        "manifest_sha256",
        "budget",
        "cells"
      ],
      "title": "NativeStudySummary",
      "type": "object"
    },
    "NativeWorkFacts": {
      "additionalProperties": false,
      "description": "Operation-local counts, not measured hardware work or proof of authenticity.",
      "properties": {
        "schema_version": {
          "const": "strange-physics.native-work-facts.v1",
          "default": "strange-physics.native-work-facts.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "attempt_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "operation": {
          "enum": [
            "candidate_production",
            "selection",
            "prediction",
            "preparation",
            "scoring",
            "purchase",
            "forward",
            "likelihood",
            "ranking",
            "reference",
            "sensitivity",
            "accounting"
          ],
          "title": "Operation",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "input_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "observation_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observation Sha256"
        },
        "model_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Sha256"
        },
        "output_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "unit": {
          "enum": [
            "candidate",
            "frame",
            "probe",
            "selection",
            "preparation",
            "record",
            "work"
          ],
          "title": "Unit",
          "type": "string"
        },
        "requested_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Requested Count",
          "type": "integer"
        },
        "completed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Completed Count",
          "type": "integer"
        },
        "failed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "not_assessed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Not Assessed Count",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "completed",
            "rejected",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "operation",
        "producer_version",
        "config_sha256",
        "input_sha256",
        "observation_sha256",
        "model_sha256",
        "output_sha256",
        "unit",
        "requested_count",
        "completed_count",
        "failed_count",
        "not_assessed_count",
        "outcome"
      ],
      "title": "NativeWorkFacts",
      "type": "object"
    },
    "StudyArtifact": {
      "additionalProperties": false,
      "description": "Exact retained producer bytes; no implied semantic validation or public audience.",
      "properties": {
        "kind": {
          "enum": [
            "candidate_config",
            "prediction_config",
            "pool",
            "menu",
            "calibration",
            "prior",
            "likelihood",
            "discrepancy",
            "scorer_protocol",
            "termination_policy",
            "failure_policy",
            "selector_random",
            "selector_uniform_disagreement",
            "selector_posterior_disagreement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_count": {
          "maximum": 8388608,
          "minimum": 1,
          "title": "Byte Count",
          "type": "integer"
        },
        "encoding": {
          "const": "strange-physics.python-json.v1",
          "default": "strange-physics.python-json.v1",
          "title": "Encoding",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sha256",
        "byte_count"
      ],
      "title": "StudyArtifact",
      "type": "object"
    },
