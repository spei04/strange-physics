      "title": "StudyAttemptUpdate",
      "type": "object"
    },
    "StudyCellOutcome": {
      "additionalProperties": false,
      "description": "Retained metadata from actual-material binding, never evaluator truth.",
      "properties": {
        "kind": {
          "const": "cell_outcome",
          "default": "cell_outcome",
          "title": "Kind",
          "type": "string"
        },
        "cell_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Cell Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "complete",
            "failed",
            "incomplete",
            "cap_limited"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "enum": [
            "scored",
            "unscorable",
            "execution_failure",
            "interrupted",
            "resource_limit"
          ],
          "title": "Reason",
          "type": "string"
        },
