        },
        "cell_id": {
          "anyOf": [
            {
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cell Id"
        },
        "operation": {
          "enum": [
            "candidate_production",
            "selection",
            "prediction",
            "preparation",
            "scoring",
            "purchase",
            "forward",
            "likelihood",
            "ranking",
            "reference",
            "sensitivity",
            "accounting"
          ],
          "title": "Operation",
          "type": "string"
        },
        "config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "input_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "retry_of": {
          "anyOf": [
            {
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
