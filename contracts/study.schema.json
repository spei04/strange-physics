    "StudyAttemptUpdate": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "update",
          "default": "update",
          "title": "Kind",
          "type": "string"
        },
        "attempt_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "state": {
          "enum": [
