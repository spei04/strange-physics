              "text/event-stream": {
                "example": "id: cursor-0\nevent: experiment.committed\ndata: {\"event\":{\"event_id\":\"event-0\",\"namespace\":{\"event_schema_version\":\"strange-physics.run-event.v1\",\"projection_version\":\"agent-safe.v1\",\"run_id\":\"run-1\",\"workspace_id\":\"ws-1\"},\"occurred_at\":100,\"operation_id\":\"experiment-1\",\"payload\":{\"artifact\":{\"artifact_id\":\"record-1\",\"generation\":\"1\",\"media_type\":\"application/json\",\"sha256\":\"fc714f11f764cc3dd09c46f942462bb5d48a22d45c67402a458dc4f973c8116a\",\"size_bytes\":430},\"index\":0,\"operation_id\":\"experiment-1\",\"record_sha256\":\"6e2c23f65d7c626b6403069e714d7cb5c72ce0c0630c3c0a05780ce06dc00fab\",\"status\":\"failed\"},\"schema_version\":\"strange-physics.run-event.v1\",\"sequence\":0,\"type\":\"experiment.committed\"},\"event_sha256\":\"30291c89daca89487801134197027fd45fab4f3d55a663da73d83cd76ceeae4f\",\"resume_cursor\":\"cursor-0\"}\n\n",
