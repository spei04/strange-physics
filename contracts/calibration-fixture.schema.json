{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "CaseId": {
      "enum": [
        "M01",
        "M02",
        "M03",
        "M04",
        "D03",
        "F02",
        "F04",
        "W03"
      ],
      "type": "string"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "B",
          "type": "string"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Connection",
      "type": "object"
    },
    "D1Blueprint": {
      "additionalProperties": false,
      "description": "Private fixed construction metadata; no generated endpoint labels.",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/CaseId"
        },
        "coefficient_denominator": {
          "const": 7,
          "default": 7,
          "title": "Coefficient Denominator",
          "type": "integer"
        },
        "coefficient_numerator": {
          "enum": [
            1,
            5,
            13,
            27
          ],
          "title": "Coefficient Numerator",
          "type": "integer"
        },
        "counts": {
          "default": [
            256,
            1024
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": 256,
              "type": "integer"
            },
            {
              "const": 1024,
              "type": "integer"
            }
          ],
          "title": "Counts",
          "type": "array"
        },
        "initial_x": {
          "title": "Initial X",
          "type": "number"
        },
        "mechanism": {
          "$ref": "#/$defs/Mechanism"
        },
        "record_count": {
          "maximum": 2,
          "minimum": 1,
          "title": "Record Count",
          "type": "integer"
        },
        "scales": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Scales",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "coefficient_numerator",
        "mechanism",
        "initial_x",
        "record_count",
        "scales"
      ],
      "title": "D1Blueprint",
      "type": "object"
    },
    "D1ExposureEntry": {
      "additionalProperties": false,
      "description": "Private producer-supplied signatures in the above canonical D1 codec.",
      "properties": {
        "identity": {
          "$ref": "#/$defs/D1PhysicalIdentity"
        },
        "source_evidence_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Evidence Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_evidence_sha256",
        "identity"
      ],
      "title": "D1ExposureEntry",
      "type": "object"
    },
    "D1ExposureFinding": {
      "additionalProperties": false,
      "properties": {
        "conclusion": {
          "enum": [
            "overlap-in-supplied-inventory",
            "no-overlap-in-supplied-inventory"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "first_exact_construction_index": {
          "anyOf": [
            {
              "exclusiveMaximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Exact Construction Index"
        },
        "first_overlap_index": {
          "anyOf": [
            {
              "exclusiveMaximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Overlap Index"
        },
        "first_reserved_coefficient_index": {
          "anyOf": [
            {
              "exclusiveMaximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Reserved Coefficient Index"
        },
        "identity_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Sha256",
          "type": "string"
        },
        "inventory_kind": {
          "enum": [
            "exposed-development",
            "reserved-comparison"
          ],
          "title": "Inventory Kind",
          "type": "string"
        },
        "inventory_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Inventory Sha256",
          "type": "string"
        },
        "overlapping_world_entries": {
          "maximum": 1024,
          "minimum": 0,
          "title": "Overlapping World Entries",
          "type": "integer"
        },
        "reserved_coefficient_entries": {
          "maximum": 1024,
          "minimum": 0,
          "title": "Reserved Coefficient Entries",
          "type": "integer"
        },
        "supplied_entries": {
          "maximum": 1024,
          "minimum": 0,
          "title": "Supplied Entries",
          "type": "integer"
        }
      },
      "required": [
        "identity_sha256",
        "inventory_sha256",
        "inventory_kind",
        "supplied_entries",
        "reserved_coefficient_entries",
        "first_reserved_coefficient_index",
        "overlapping_world_entries",
        "first_overlap_index",
        "first_exact_construction_index",
        "conclusion"
      ],
      "title": "D1ExposureFinding",
      "type": "object"
    },
    "D1ExposureInventory": {
      "additionalProperties": false,
      "properties": {
        "completeness": {
          "const": "not-established-by-this-contract",
          "default": "not-established-by-this-contract",
          "title": "Completeness",
          "type": "string"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/D1ExposureEntry"
          },
          "maxItems": 1024,
          "title": "Entries",
          "type": "array"
        },
        "inventory_kind": {
          "enum": [
            "exposed-development",
            "reserved-comparison"
          ],
          "title": "Inventory Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.d1-exposure-inventory.v1",
          "default": "strange-physics.d1-exposure-inventory.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "inventory_kind",
        "entries"
      ],
      "title": "D1ExposureInventory",
      "type": "object"
    },
    "D1FixtureOutcome": {
      "additionalProperties": false,
      "description": "Private construction failures never become failed or completed purchases.",
      "properties": {
        "audit": {
          "anyOf": [
            {
              "$ref": "#/$defs/D1PrivateAudit"
            },
            {
              "type": "null"
            }
          ]
        },
        "blueprint": {
          "$ref": "#/$defs/D1Blueprint"
        },
        "failure_evidence_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failure Evidence Sha256"
        },
        "failure_stage": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureStage"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "unrun",
            "failed",
            "materialized"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "blueprint",
        "status",
        "failure_stage",
        "failure_evidence_sha256",
        "audit"
      ],
      "title": "D1FixtureOutcome",
      "type": "object"
    },
    "D1FixtureOutcomes": {
      "additionalProperties": false,
      "properties": {
        "outcomes": {
          "items": {
            "$ref": "#/$defs/D1FixtureOutcome"
          },
          "maxItems": 8,
          "minItems": 8,
          "title": "Outcomes",
          "type": "array"
        },
        "schema_version": {
          "const": "strange-physics.d1-fixture-outcomes.v1",
          "default": "strange-physics.d1-fixture-outcomes.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "outcomes"
      ],
      "title": "D1FixtureOutcomes",
      "type": "object"
    },
    "D1LabelClaim": {
      "additionalProperties": false,
      "description": "Reference/one-rounding evidence is supplied, not proved by this message.",
      "properties": {
        "recorded_x_hex": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Recorded X Hex",
          "type": "string"
        },
        "reference_evidence_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reference Evidence Sha256",
          "type": "string"
        },
        "rounding_evidence_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rounding Evidence Sha256",
          "type": "string"
        }
      },
      "required": [
        "recorded_x_hex",
        "reference_evidence_sha256",
        "rounding_evidence_sha256"
      ],
      "title": "D1LabelClaim",
      "type": "object"
    },
    "D1OwnerReviewReference": {
      "additionalProperties": false,
      "description": "Untrusted supplied pointer to external review; not a signature, grant or freeze.",
      "properties": {
        "comparison_inventory_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Comparison Inventory Sha256",
          "type": "string"
        },
        "development_inventory_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Development Inventory Sha256",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "pending",
            "rejected",
            "externally-reviewed"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "fixture_outcomes_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fixture Outcomes Sha256",
          "type": "string"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/ProtocolHash",
          "default": "657c3c74346aedb165473b4672ed18ba5671da82e4873a2a3e6f514b58387399"
        },
        "review_evidence_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Evidence Sha256",
          "type": "string"
        },
        "scope": {
          "const": "historical-completeness-requires-independent-review",
          "default": "historical-completeness-requires-independent-review",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "development_inventory_sha256",
        "comparison_inventory_sha256",
        "fixture_outcomes_sha256",
        "review_evidence_sha256",
        "disposition"
      ],
      "title": "D1OwnerReviewReference",
      "type": "object"
    },
    "D1PhysicalIdentity": {
      "additionalProperties": false,
      "properties": {
        "action_sha256": {
          "items": {
            "maxLength": 64,
            "minLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Action Sha256",
          "type": "array"
        },
        "coefficient_hex": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Coefficient Hex",
          "type": "string"
        },
        "history_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "History Sha256",
          "type": "string"
        },
        "probe_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Probe Sha256",
          "type": "string"
        },
        "world_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "World Sha256",
          "type": "string"
        }
      },
      "required": [
        "coefficient_hex",
        "world_sha256",
        "history_sha256",
        "action_sha256",
        "probe_sha256"
      ],
      "title": "D1PhysicalIdentity",
      "type": "object"
    },
    "D1PrivateAudit": {
      "additionalProperties": false,
      "description": "Evaluator-only map from exposed blueprints to opaque public material.",
      "properties": {
        "authority": {
          "const": "supplied-material-not-numerical-proof",
          "default": "supplied-material-not-numerical-proof",
          "title": "Authority",
          "type": "string"
        },
        "blueprint": {
          "$ref": "#/$defs/D1Blueprint"
        },
        "coefficient_hex": {
          "maxLength": 32,
          "minLength": 1,
          "title": "Coefficient Hex",
          "type": "string"
        },
        "future_initial_x": {
          "const": 1.0,
          "default": 1.0,
          "title": "Future Initial X",
          "type": "number"
        },
        "future_label": {
          "$ref": "#/$defs/D1LabelClaim"
        },
        "future_time": {
          "const": 0.75,
          "default": 0.75,
          "title": "Future Time",
          "type": "number"
        },
        "protocol_sha256": {
          "$ref": "#/$defs/ProtocolHash",
          "default": "657c3c74346aedb165473b4672ed18ba5671da82e4873a2a3e6f514b58387399"
        },
        "public_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.d1-private-audit.v1",
          "default": "strange-physics.d1-private-audit.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_commit": {
          "maxLength": 40,
          "minLength": 40,
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Commit",
          "type": "string"
        },
        "training_labels": {
          "items": {
            "$ref": "#/$defs/D1LabelClaim"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Training Labels",
          "type": "array"
        }
      },
      "required": [
        "source_commit",
        "blueprint",
        "public_sha256",
        "coefficient_hex",
        "training_labels",
        "future_label"
      ],
      "title": "D1PrivateAudit",
      "type": "object"
    },
    "D1PublicFixture": {
      "additionalProperties": false,
      "description": "Candidate-visible observations only; no blueprint or private proof digest.",
      "properties": {
        "observations": {
          "$ref": "#/$defs/ObservationBundle"
        },
        "provenance": {
          "const": "synthetic-terminal-x-development.v1",
          "default": "synthetic-terminal-x-development.v1",
          "title": "Provenance",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.d1-public-fixture.v1",
          "default": "strange-physics.d1-public-fixture.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "velocity_semantics": {
          "const": "unused-zero-placeholder",
          "default": "unused-zero-placeholder",
          "title": "Velocity Semantics",
          "type": "string"
        }
      },
      "required": [
        "observations"
      ],
      "title": "D1PublicFixture",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "impulse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impulse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "particles": {
          "items": {
            "$ref": "#/$defs/ParticleInitial"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Particles",
          "type": "array"
        },
        "schema_version": {
          "const": "strange-physics.experiment.v1",
          "default": "strange-physics.experiment.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "particles"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "const": "simulation_failed",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "operation_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Operation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trajectory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "index",
        "experiment",
        "status"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "ExperimentSpace": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "default": 40,
          "maximum": 10000,
          "minimum": 1,
          "title": "Budget",
          "type": "integer"
        },
        "calibration_experiments": {
          "default": 4,
          "minimum": 0,
          "title": "Calibration Experiments",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Limits",
          "default": {
            "impulse_norm": 1.0,
            "max_mass": 2.0,
            "min_mass": 0.5,
            "position_norm": 2.0,
            "velocity_norm": 2.0
          }
        },
        "sampling": {
          "$ref": "#/$defs/Sampling"
        },
        "schema_version": {
          "const": "strange-physics.space.v1",
          "default": "strange-physics.space.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/Structure"
        }
      },
      "required": [
        "structure",
        "sampling"
      ],
      "title": "ExperimentSpace",
      "type": "object"
    },
    "FailureStage": {
      "enum": [
        "reference",
        "rounding",
        "public_binding",
        "exposure"
      ],
      "type": "string"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "positions": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Positions",
          "type": "array"
        },
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "number"
        },
        "velocities": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Velocities",
          "type": "array"
        }
      },
      "required": [
        "time",
        "positions",
        "velocities"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Impulse": {
      "additionalProperties": false,
      "properties": {
        "particle_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Particle Id",
          "type": "string"
        },
        "vector": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "particle_id",
        "vector"
      ],
      "title": "Impulse",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "impulse_norm": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Impulse Norm",
          "type": "number"
        },
        "max_mass": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Mass",
          "type": "number"
        },
        "min_mass": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Min Mass",
          "type": "number"
        },
        "position_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Position Norm",
          "type": "number"
        },
        "velocity_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Velocity Norm",
          "type": "number"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Mechanism": {
      "enum": [
        "zero-rest-spring",
