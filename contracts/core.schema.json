{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Agent Id",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.checkpoint.v1",
          "default": "strange-physics.checkpoint.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "State",
          "type": "object"
        },
        "through_index": {
          "minimum": -1,
          "title": "Through Index",
          "type": "integer"
        }
      },
      "required": [
        "agent_id",
        "through_index",
        "state"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "B",
          "type": "string"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "impulse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impulse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "particles": {
          "items": {
            "$ref": "#/$defs/ParticleInitial"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Particles",
          "type": "array"
        },
        "schema_version": {
          "const": "strange-physics.experiment.v1",
          "default": "strange-physics.experiment.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "particles"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "const": "simulation_failed",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "operation_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Operation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trajectory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "index",
        "experiment",
        "status"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "ExperimentSpace": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "default": 40,
          "maximum": 10000,
          "minimum": 1,
          "title": "Budget",
          "type": "integer"
        },
        "calibration_experiments": {
          "default": 4,
          "minimum": 0,
          "title": "Calibration Experiments",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Limits",
          "default": {
            "impulse_norm": 1.0,
            "max_mass": 2.0,
            "min_mass": 0.5,
            "position_norm": 2.0,
            "velocity_norm": 2.0
          }
        },
        "sampling": {
          "$ref": "#/$defs/Sampling"
        },
        "schema_version": {
          "const": "strange-physics.space.v1",
          "default": "strange-physics.space.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/Structure"
        }
      },
      "required": [
        "structure",
        "sampling"
      ],
      "title": "ExperimentSpace",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "positions": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Positions",
          "type": "array"
        },
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "number"
        },
        "velocities": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Velocities",
          "type": "array"
        }
      },
      "required": [
        "time",
        "positions",
        "velocities"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Impulse": {
      "additionalProperties": false,
      "properties": {
        "particle_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Particle Id",
          "type": "string"
        },
        "vector": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "particle_id",
        "vector"
      ],
      "title": "Impulse",
      "type": "object"
    },
    "JsonValue": {},
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "impulse_norm": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Impulse Norm",
          "type": "number"
        },
        "max_mass": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Mass",
          "type": "number"
        },
        "min_mass": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Min Mass",
          "type": "number"
        },
        "position_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Position Norm",
          "type": "number"
        },
        "velocity_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Velocity Norm",
          "type": "number"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "ObservationBundle": {
      "additionalProperties": false,
      "properties": {
        "engine_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ExperimentRecord"
          },
          "maxItems": 10000,
          "title": "Records",
          "type": "array"
        },
        "run_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.observations.v1",
          "default": "strange-physics.observations.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/ExperimentSpace"
        }
      },
      "required": [
        "run_id",
        "engine_version",
        "engine_fingerprint",
        "space",
        "records"
      ],
      "title": "ObservationBundle",
      "type": "object"
    },
    "ParticleInitial": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "mass": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Mass",
          "type": "number"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "velocity": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Velocity",
          "type": "array"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "ParticleInitial",
      "type": "object"
    },
    "Sampling": {
      "additionalProperties": false,
      "properties": {
        "dt": {
          "default": 0.01,
          "maximum": 0.05,
          "minimum": 0.0001,
          "title": "Dt",
          "type": "number"
        },
        "duration": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Duration",
          "type": "number"
        },
        "position_noise": {
          "default": 0.0,
          "maximum": 0.1,
          "minimum": 0,
          "title": "Position Noise",
          "type": "number"
        },
        "sample_interval": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Sample Interval",
          "type": "number"
        },
        "velocity_noise": {
          "default": 0.0,
          "maximum": 0.1,
          "minimum": 0,
          "title": "Velocity Noise",
          "type": "number"
        }
      },
      "title": "Sampling",
      "type": "object"
    },
    "Structure": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "maxItems": 8,
          "title": "Anchors",
          "type": "array"
        },
        "connections": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "maxItems": 120,
          "title": "Connections",
          "type": "array"
        },
        "particle_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Particle Ids",
          "type": "array"
        }
      },
      "required": [
        "particle_ids"
      ],
      "title": "Structure",
      "type": "object"
    },
    "Trajectory": {
      "additionalProperties": false,
      "properties": {
        "frames": {
          "items": {
            "$ref": "#/$defs/Frame"
          },
          "maxItems": 2001,
          "minItems": 2,
          "title": "Frames",
          "type": "array"
        }
      },
      "required": [
        "frames"
      ],
      "title": "Trajectory",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema definitions exported from the existing public Pydantic contracts. Validate against a named definition. Cross-field numerical and identity invariants still require runtime validation.",
  "x-source": "src/strange_physics/contracts.py"
}
