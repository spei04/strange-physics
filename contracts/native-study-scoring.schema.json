          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Sha256"
        },
        "observation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "policy_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Policy Sha256",
          "type": "string"
        },
        "predictions_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Predictions Sha256",
          "type": "string"
        },
        "preparation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Preparation Sha256",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "preparation_rejected",
                "preparation_mismatch",
                "prediction_mismatch",
                "attempt_reuse",
                "world_space_mismatch"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "schema_version": {
          "const": "strange-physics.native-score-outcome.v1",
          "default": "strange-physics.native-score-outcome.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "evaluated",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "submissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpringPredictionSubmissions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
