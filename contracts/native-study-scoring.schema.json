        "model_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Sha256",
          "type": "string"
        },
        "normalization_scale": {
          "exclusiveMinimum": 0,
          "title": "Normalization Scale",
          "type": "number"
        },
        "normalized_position_mse": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Normalized Position Mse"
        },
        "position_mse": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Position Mse"
        },
        "probe_count": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Probe Count",
          "type": "integer"
        },
        "protocol_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.evaluation-report.v1",
          "default": "strange-physics.evaluation-report.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "split": {
          "const": "development",
          "default": "development",
