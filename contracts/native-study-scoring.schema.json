        "status",
        "reason",
        "input_sha256",
        "policy_sha256",
        "observation_sha256",
        "model_sha256",
        "preparation_sha256",
        "predictions_sha256",
        "submissions",
        "evaluation"
      ],
      "title": "NativeScoreOutcome",
      "type": "object"
    },
