{
  "$defs": {
    "BrokerExchangeRequest": {
      "additionalProperties": false,
      "properties": {
        "id_token": {
          "format": "password",
          "maxLength": 16384,
          "minLength": 1,
          "title": "Id Token",
          "type": "string",
          "writeOnly": true
        },
        "transaction_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Transaction Id",
          "type": "string"
        }
      },
      "required": [
        "transaction_id",
        "id_token"
      ],
      "title": "BrokerExchangeRequest",
      "type": "object"
    },
    "BrowserContext": {
      "additionalProperties": false,
      "description": "Trusted HTTP adapter projection; CSRF comparisons must be constant-time.",
      "properties": {
        "browser_binding_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Browser Binding Sha256"
        },
        "csrf_matches": {
          "title": "Csrf Matches",
          "type": "boolean"
        },
        "csrf_scope": {
          "anyOf": [
            {
              "enum": [
                "preauth",
                "session"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Csrf Scope"
        },
        "has_bearer": {
          "title": "Has Bearer",
          "type": "boolean"
        },
        "has_session_cookie": {
          "title": "Has Session Cookie",
          "type": "boolean"
        },
        "origin": {
          "anyOf": [
            {
              "maxLength": 2048,
              "minLength": 9,
              "not": {
                "pattern": "[^!-~]"
              },
              "pattern": "^https://[!-~]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Origin"
        },
        "target_origin": {
          "maxLength": 2048,
          "minLength": 9,
          "not": {
            "pattern": "[^!-~]"
          },
          "pattern": "^https://[!-~]+$",
          "title": "Target Origin",
          "type": "string"
        }
      },
      "required": [
        "target_origin",
        "origin",
        "has_session_cookie",
        "has_bearer",
        "csrf_scope",
        "csrf_matches",
        "browser_binding_sha256"
      ],
      "title": "BrowserContext",
      "type": "object"
    },
    "CSRFResponse": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "preauth",
            "session"
          ],
          "title": "Scope",
          "type": "string"
        },
        "token": {
          "maxLength": 16384,
          "minLength": 1,
          "readOnly": true,
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "token"
      ],
      "title": "CSRFResponse",
      "type": "object"
    },
    "DeploymentSessionPolicy": {
      "additionalProperties": false,
      "properties": {
        "absolute_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Absolute Seconds",
          "type": "integer"
        },
        "app_origins": {
          "items": {
            "maxLength": 2048,
            "minLength": 9,
            "not": {
              "pattern": "[^!-~]"
            },
            "pattern": "^https://[!-~]+$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "App Origins",
          "type": "array"
        },
        "clock_skew_seconds": {
          "maximum": 300,
          "minimum": 0,
          "title": "Clock Skew Seconds",
          "type": "integer"
        },
        "idle_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Idle Seconds",
          "type": "integer"
        },
        "login_ttl_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Login Ttl Seconds",
          "type": "integer"
        },
        "policy_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Policy Id",
          "type": "string"
        },
        "providers": {
          "items": {
            "$ref": "#/$defs/ProviderPolicy"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Providers",
          "type": "array"
        },
        "recent_auth_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Recent Auth Seconds",
          "type": "integer"
        },
        "return_uris": {
          "items": {
            "maxLength": 2048,
            "minLength": 9,
            "not": {
              "pattern": "[^!-~]"
            },
            "pattern": "^https://[!-~]+$",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Return Uris",
          "type": "array"
        },
        "schema_version": {
          "const": "strange-physics.session-policy.v1",
          "default": "strange-physics.session-policy.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "transaction_retention_seconds": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Transaction Retention Seconds",
          "type": "integer"
        }
      },
      "required": [
        "policy_id",
        "app_origins",
        "return_uris",
        "providers",
        "idle_seconds",
        "absolute_seconds",
        "recent_auth_seconds",
        "login_ttl_seconds",
        "clock_skew_seconds",
        "transaction_retention_seconds"
      ],
      "title": "DeploymentSessionPolicy",
      "type": "object"
    },
