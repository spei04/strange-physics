{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        }
      },
      "required": [
        "id",
        "position"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "A",
          "type": "string"
        },
        "b": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "B",
          "type": "string"
        }
      },
      "required": [
        "a",
        "b"
      ],
      "title": "Connection",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "impulse": {
          "anyOf": [
            {
              "$ref": "#/$defs/Impulse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "particles": {
          "items": {
            "$ref": "#/$defs/ParticleInitial"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Particles",
          "type": "array"
        },
        "schema_version": {
          "const": "strange-physics.experiment.v1",
          "default": "strange-physics.experiment.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "particles"
      ],
      "title": "Experiment",
      "type": "object"
    },
    "ExperimentRecord": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "const": "simulation_failed",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "experiment": {
          "$ref": "#/$defs/Experiment"
        },
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "operation_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Operation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "trajectory": {
          "anyOf": [
            {
              "$ref": "#/$defs/Trajectory"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "operation_id",
        "index",
        "experiment",
        "status"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "ExperimentSpace": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "default": 40,
          "maximum": 10000,
          "minimum": 1,
          "title": "Budget",
          "type": "integer"
        },
        "calibration_experiments": {
          "default": 4,
          "minimum": 0,
          "title": "Calibration Experiments",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Limits",
          "default": {
            "impulse_norm": 1.0,
            "max_mass": 2.0,
            "min_mass": 0.5,
            "position_norm": 2.0,
            "velocity_norm": 2.0
          }
        },
        "sampling": {
          "$ref": "#/$defs/Sampling"
        },
        "schema_version": {
          "const": "strange-physics.space.v1",
          "default": "strange-physics.space.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "structure": {
          "$ref": "#/$defs/Structure"
        }
      },
      "required": [
        "structure",
        "sampling"
      ],
      "title": "ExperimentSpace",
      "type": "object"
    },
    "Frame": {
      "additionalProperties": false,
      "properties": {
        "positions": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Positions",
          "type": "array"
        },
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "number"
        },
        "velocities": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Velocities",
          "type": "array"
        }
      },
      "required": [
        "time",
        "positions",
        "velocities"
      ],
      "title": "Frame",
      "type": "object"
    },
    "Impulse": {
      "additionalProperties": false,
      "properties": {
        "particle_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Particle Id",
          "type": "string"
        },
        "vector": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Vector",
          "type": "array"
        }
      },
      "required": [
        "particle_id",
        "vector"
      ],
      "title": "Impulse",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "impulse_norm": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Impulse Norm",
          "type": "number"
        },
        "max_mass": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Max Mass",
          "type": "number"
        },
        "min_mass": {
          "default": 0.5,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Min Mass",
          "type": "number"
        },
        "position_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Position Norm",
          "type": "number"
        },
        "velocity_norm": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "title": "Velocity Norm",
          "type": "number"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "LinearSpringModel": {
      "additionalProperties": false,
      "description": "A fitted shared linear coefficient, with explicit observation provenance.",
      "properties": {
        "fit_config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fit Config Sha256",
          "type": "string"
        },
        "fit_record_indices": {
          "items": {
            "maximum": 9999,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 10000,
          "minItems": 1,
          "title": "Fit Record Indices",
          "type": "array"
        },
        "fitter_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Fitter Version",
          "type": "string"
        },
        "linear": {
          "minimum": 0,
          "title": "Linear",
          "type": "number"
        },
        "observation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.linear-spring-model.v1",
          "default": "strange-physics.linear-spring-model.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "through_index": {
          "maximum": 9999,
          "minimum": 0,
          "title": "Through Index",
          "type": "integer"
        }
      },
      "required": [
        "linear",
        "through_index",
        "fit_record_indices",
        "observation_sha256",
        "fitter_version",
        "fit_config_sha256"
      ],
      "title": "LinearSpringModel",
      "type": "object"
    },
    "NativeCandidateConfig": {
      "additionalProperties": false,
      "description": "Fixed producer semantics and support caps, not a chosen grid or prior.",
      "properties": {
        "algorithm": {
          "const": "enumerate-declared-pool.v1",
          "default": "enumerate-declared-pool.v1",
          "title": "Algorithm",
          "type": "string"
        },
        "failure_policy": {
          "const": "no-partial-candidate-set.v1",
          "default": "no-partial-candidate-set.v1",
          "title": "Failure Policy",
          "type": "string"
        },
        "max_candidates": {
          "default": 1025,
          "maximum": 1025,
          "minimum": 1025,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_input_bytes": {
          "default": 8388608,
          "maximum": 8388608,
          "minimum": 8388608,
          "title": "Max Input Bytes",
          "type": "integer"
        },
        "max_json_depth": {
          "default": 32,
          "maximum": 32,
          "minimum": 32,
          "title": "Max Json Depth",
          "type": "integer"
        },
        "max_json_nodes": {
          "default": 1000000,
          "maximum": 1000000,
          "minimum": 1000000,
          "title": "Max Json Nodes",
          "type": "integer"
        },
        "max_records": {
          "default": 12,
          "maximum": 12,
          "minimum": 12,
          "title": "Max Records",
          "type": "integer"
        },
        "max_result_bytes": {
          "default": 4194304,
          "maximum": 4194304,
          "minimum": 4194304,
          "title": "Max Result Bytes",
          "type": "integer"
        },
        "producer_version": {
          "const": "strange-physics.linear-spring.native-candidates.v1",
          "default": "strange-physics.linear-spring.native-candidates.v1",
          "title": "Producer Version",
          "type": "string"
        },
        "record_selection": {
          "const": "all-completed-prefix.v1",
          "default": "all-completed-prefix.v1",
          "title": "Record Selection",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.native-candidate-config.v1",
          "default": "strange-physics.native-candidate-config.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "title": "NativeCandidateConfig",
      "type": "object"
    },
    "NativeCandidateInput": {
      "additionalProperties": false,
      "description": "Actual pool/config and committed public observations; never pending reservations.",
      "properties": {
        "config": {
          "$ref": "#/$defs/NativeCandidateConfig"
        },
        "observations": {
          "$ref": "#/$defs/ObservationBundle"
        },
        "pool": {
          "$ref": "#/$defs/NativeSpringPool"
        },
        "schema_version": {
          "const": "strange-physics.native-candidate-input.v1",
          "default": "strange-physics.native-candidate-input.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "pool",
        "config",
        "observations"
      ],
      "title": "NativeCandidateInput",
      "type": "object"
    },
    "NativeCandidateOutcome": {
      "additionalProperties": false,
      "description": "A complete declared candidate set, or counted failure with no partial models.",
      "properties": {
        "completed_record_indices": {
          "items": {
            "maximum": 11,
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 12,
          "title": "Completed Record Indices",
          "type": "array"
        },
        "failed_candidate_index": {
          "anyOf": [
            {
              "maximum": 1024,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Failed Candidate Index"
        },
        "failed_record_count": {
          "maximum": 12,
          "minimum": 0,
          "title": "Failed Record Count",
          "type": "integer"
        },
        "inference_claim": {
          "const": "none",
          "default": "none",
          "title": "Inference Claim",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/LinearSpringModel"
          },
          "maxItems": 1025,
          "title": "Models",
          "type": "array"
        },
        "observation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "pool_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pool Sha256",
          "type": "string"
        },
        "produced_candidate_count": {
          "maximum": 1025,
          "minimum": 0,
          "title": "Produced Candidate Count",
          "type": "integer"
        },
        "producer_config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Producer Config Sha256",
          "type": "string"
        },
        "producer_version": {
          "const": "strange-physics.linear-spring.native-candidates.v1",
          "default": "strange-physics.linear-spring.native-candidates.v1",
          "title": "Producer Version",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_completed_records",
                "unsupported_domain",
                "resource_limit",
                "candidate_construction"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "requested_candidate_count": {
          "maximum": 1025,
          "minimum": 1,
          "title": "Requested Candidate Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "strange-physics.native-candidate-outcome.v1",
          "default": "strange-physics.native-candidate-outcome.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "produced",
            "rejected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "through_index": {
          "maximum": 11,
          "minimum": -1,
          "title": "Through Index",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "reason",
        "pool_sha256",
        "observation_sha256",
        "producer_config_sha256",
        "through_index",
        "completed_record_indices",
        "failed_record_count",
        "requested_candidate_count",
        "produced_candidate_count",
        "failed_candidate_index",
        "models"
      ],
      "title": "NativeCandidateOutcome",
      "type": "object"
    },
    "NativeCandidateResult": {
      "additionalProperties": false,
      "description": "Outcome plus locally accountable identities; output hash excludes these facts.",
      "properties": {
        "facts": {
          "$ref": "#/$defs/NativeWorkFacts"
        },
        "payload": {
          "$ref": "#/$defs/NativeCandidateOutcome"
        },
        "schema_version": {
          "const": "strange-physics.native-candidate-result.v1",
          "default": "strange-physics.native-candidate-result.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "payload",
        "facts"
      ],
      "title": "NativeCandidateResult",
      "type": "object"
    },
    "NativeSpringPool": {
      "additionalProperties": false,
      "description": "A common ordered coefficient pool, independent of any arm or purchased prefix.",
      "properties": {
        "coefficients": {
          "items": {
            "maximum": 4.0,
            "minimum": 0.0,
            "type": "number"
          },
          "maxItems": 1025,
          "minItems": 1,
          "title": "Coefficients",
          "type": "array"
        },
        "model_assumption": {
          "const": "stationary-shared-zero-rest-linear-spring.v1",
          "default": "stationary-shared-zero-rest-linear-spring.v1",
          "title": "Model Assumption",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.native-spring-pool.v1",
          "default": "strange-physics.native-spring-pool.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "coefficients"
      ],
      "title": "NativeSpringPool",
      "type": "object"
    },
    "NativeWorkFacts": {
      "additionalProperties": false,
      "description": "Operation-local facts, not a ledger, timing measurement or proof of execution.\n\nattempt_id is an opaque ledger-issued parent-envelope correlation. Multiple\ninternal operations may share it; RA-02 owns reservation, measurement and totals.",
      "properties": {
        "attempt_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "completed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Completed Count",
          "type": "integer"
        },
        "config_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "failed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Failed Count",
          "type": "integer"
        },
        "input_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "model_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Sha256"
        },
        "not_assessed_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Not Assessed Count",
          "type": "integer"
        },
        "observation_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Observation Sha256",
          "type": "string"
        },
        "operation": {
          "enum": [
            "candidate_production",
            "selection",
            "prediction",
            "preparation",
            "scoring"
          ],
          "title": "Operation",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "completed",
            "rejected",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Output Sha256",
          "type": "string"
        },
        "producer_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "requested_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Requested Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "strange-physics.native-work-facts.v1",
          "default": "strange-physics.native-work-facts.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "enum": [
            "candidate",
            "frame",
            "probe",
            "selection",
            "preparation",
            "work"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "operation",
        "producer_version",
        "config_sha256",
        "input_sha256",
        "observation_sha256",
        "model_sha256",
        "output_sha256",
        "unit",
        "requested_count",
        "completed_count",
        "failed_count",
        "not_assessed_count",
        "outcome"
      ],
      "title": "NativeWorkFacts",
      "type": "object"
    },
    "ObservationBundle": {
      "additionalProperties": false,
      "properties": {
        "engine_fingerprint": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Engine Fingerprint",
          "type": "string"
        },
        "engine_version": {
          "title": "Engine Version",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/ExperimentRecord"
          },
          "maxItems": 10000,
          "title": "Records",
          "type": "array"
        },
        "run_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": "strange-physics.observations.v1",
          "default": "strange-physics.observations.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "space": {
          "$ref": "#/$defs/ExperimentSpace"
        }
      },
      "required": [
        "run_id",
        "engine_version",
        "engine_fingerprint",
        "space",
        "records"
      ],
      "title": "ObservationBundle",
      "type": "object"
    },
    "ParticleInitial": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "mass": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "title": "Mass",
          "type": "number"
        },
        "position": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Position",
          "type": "array"
        },
        "velocity": {
          "default": [
            0.0,
            0.0
          ],
