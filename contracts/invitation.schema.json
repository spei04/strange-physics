        },
        "last_seen_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Last Seen At",
          "type": "integer"
        },
        "policy_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
