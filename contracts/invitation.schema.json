    "VerifiedEmailAssertion": {
      "additionalProperties": false,
      "description": "Verified upstream evidence; issued_at is upstream time, not local parsing.",
      "properties": {
        "assertion_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assertion Sha256",
          "type": "string"
        },
        "audience": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Audience",
          "type": "string"
        },
        "email": {
          "maxLength": 254,
          "minLength": 3,
          "not": {
            "pattern": "[^!-~]"
          },
          "pattern": "^[A-Za-z0-9!#$%&'*+/=?^_{`|}~-]+(?:\\.[A-Za-z0-9!#$%&'*+/=?^_{`|}~-]+)*@[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)+$",
          "title": "Email",
          "type": "string"
        },
        "email_verified": {
          "title": "Email Verified",
          "type": "boolean"
        },
        "expires_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Expires At",
          "type": "integer"
        },
        "issued_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Issued At",
          "type": "integer"
        },
        "issuer": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Issuer",
          "type": "string"
        },
        "provider_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Provider Id",
          "type": "string"
        },
        "session_generation": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Session Generation",
          "type": "integer"
        },
        "session_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Session Id",
          "type": "string"
        },
        "subject": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "tenant_id": {
          "anyOf": [
            {
              "not": {
                "pattern": "[^A-Za-z0-9_-]"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tenant Id"
        },
        "upstream_provider": {
          "anyOf": [
            {
              "enum": [
                "google.com",
                "github.com"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Upstream Provider"
        },
        "verified_at": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Verified At",
          "type": "integer"
        }
      },
      "required": [
        "provider_id",
        "tenant_id",
        "issuer",
        "subject",
        "session_id",
        "session_generation",
        "email",
        "email_verified",
        "audience",
        "upstream_provider",
        "issued_at",
        "expires_at",
        "verified_at",
        "assertion_sha256"
      ],
      "title": "VerifiedEmailAssertion",
      "type": "object"
    },
    "WorkspaceAuthority": {
      "additionalProperties": false,
      "description": "Complete current owner set from the same locked workspace revision.\n\nSQL producers establish completeness and currency under the shared lock.\nactive_owner_ids counts active human owner membership rows; disabled_owner_ids\nidentifies rows whose principals are currently disabled. During security fan-out,\nstored workspace state can lag; composed authorization checks both facts.",
      "properties": {
        "active_owner_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Active Owner Ids",
          "type": "array"
        },
        "disabled_owner_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Disabled Owner Ids",
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceView"
        }
      },
      "required": [
        "workspace",
        "active_owner_ids",
        "disabled_owner_ids"
      ],
      "title": "WorkspaceAuthority",
      "type": "object"
    },
    "WorkspaceView": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "active",
            "quarantined"
          ],
          "title": "State",
          "type": "string"
        },
        "visibility": {
          "const": "private",
          "title": "Visibility",
          "type": "string"
        },
        "workspace_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "display_name",
        "visibility",
        "state",
        "revision"
      ],
      "title": "WorkspaceView",
      "type": "object"
    }
  },
