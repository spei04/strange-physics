    "WorkspaceAuthority": {
      "additionalProperties": false,
      "description": "Complete current owner set from the same locked workspace revision.\n\nSQL producers establish completeness and currency under the shared lock.\nactive_owner_ids counts active human owner membership rows; disabled_owner_ids\nidentifies rows whose principals are currently disabled. During security fan-out,\nstored workspace state can lag; composed authorization checks both facts.",
      "properties": {
        "active_owner_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Active Owner Ids",
          "type": "array"
        },
        "disabled_owner_ids": {
          "items": {
            "not": {
              "pattern": "[^A-Za-z0-9_-]"
            },
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "type": "string"
          },
          "title": "Disabled Owner Ids",
          "type": "array"
        },
        "workspace": {
          "$ref": "#/$defs/WorkspaceView"
        }
      },
      "required": [
        "workspace",
        "active_owner_ids",
        "disabled_owner_ids"
      ],
      "title": "WorkspaceAuthority",
      "type": "object"
    },
    "WorkspaceView": {
      "additionalProperties": false,
      "properties": {
        "display_name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "revision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "state": {
          "enum": [
            "active",
            "quarantined"
          ],
          "title": "State",
          "type": "string"
        },
        "visibility": {
          "const": "private",
          "title": "Visibility",
          "type": "string"
        },
        "workspace_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "display_name",
        "visibility",
        "state",
        "revision"
      ],
      "title": "WorkspaceView",
      "type": "object"
    }
