              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Principal Id"
        },
        "workspace_id": {
          "not": {
            "pattern": "[^A-Za-z0-9_-]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
